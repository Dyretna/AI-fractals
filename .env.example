# AI-Fractals Environment Configuration
# Copy this file to .env and adjust for your system
# Then run: source activate_env.sh

# Project directory
PROJECT_DIR=/path/to/your/project

# ============================================================
# CUDA/GPU Configuration
# ============================================================

# IMPORTANT: Set NVIDIA_BASE to your Python environment's nvidia package location
# Find it with: python -c "import sys, pathlib; print(pathlib.Path(sys.prefix) / 'lib/python3.10/site-packages/nvidia')"
NVIDIA_BASE=/path/to/your/env/lib/python3.10/site-packages/nvidia

# System CUDA libraries + TensorFlow bundled CUDA libraries
# This is the key to making GPU work!
LD_LIBRARY_PATH=${NVIDIA_BASE}/cublas/lib:${NVIDIA_BASE}/cuda_cupti/lib:${NVIDIA_BASE}/cuda_nvrtc/lib:${NVIDIA_BASE}/cuda_runtime/lib:${NVIDIA_BASE}/cudnn/lib:${NVIDIA_BASE}/cufft/lib:${NVIDIA_BASE}/curand/lib:${NVIDIA_BASE}/cusolver/lib:${NVIDIA_BASE}/cusparse/lib:${NVIDIA_BASE}/nccl/lib:/usr/lib:${LD_LIBRARY_PATH}

# Force CPU mode (set to true to disable GPU)
FORCE_CPU=false

# GPU memory limit in MB (leave empty for no limit)
GPU_MEMORY_LIMIT=

# Allow GPU memory growth (true/false)
GPU_ALLOW_GROWTH=true

# Enable mixed precision training (true/false)
GPU_MIXED_PRECISION=true

# ============================================================
# Setup Instructions
# ============================================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. Update NVIDIA_BASE path (find it with the command above)

# 3. Activate environment before running Python:
#    source activate_env.sh

# 4. Test GPU detection:
#    python scripts/check_hardware.py

# 5. Train models:
#    python scripts/train_gan_example.py
